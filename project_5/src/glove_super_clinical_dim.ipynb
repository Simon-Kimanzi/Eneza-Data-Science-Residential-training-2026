      "Mean OOV rate: 0.047\n"
     ]
    }
   ],
   "source": [
    "#applying the GloVe to the tokens\n",
    "X_path2 = np.array([document_vector(tokens, embeddings_index) for tokens in path2_df['tokens']])\n",
    "oov_rates_path2 = path2_df['tokens'].apply(lambda t: oov_rate(t, embeddings_index))\n",
    "\n",
    "print(f\"Vector matrix shape: {X_path2.shape}\")\n",
    "print(f\"Mean OOV rate: {oov_rates_path2.mean():.3f}\")"
   ]

   "source": [
    "Build document vectors using GloVe (mean pooling) and check OOV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "051eb857",
   "metadata": {},
   "outputs": [],
   "source": [
    "def document_vector(tokens, embeddings, dim=100):\n",
    "    valid_vectors = [embeddings[word] for word in tokens if word in embeddings]\n",
    "    if not valid_vectors:\n",
    "        return np.zeros(dim)\n",
    "    return np.mean(valid_vectors, axis=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "eb5af659",
   "metadata": {},
   "outputs": [],
   "source": [
    "def oov_rate(tokens, embeddings):\n",
    "    if not tokens:\n",
    "        return 0\n",
    "    in_vocab = sum(1 for t in tokens if t in embeddings)\n",
    "    return 1 - (in_vocab / len(tokens))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "9d571c9e",
   "metadata": {},
   "outputs": [

    "Tokenization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "01ea6aa9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Loaded 808 clinical stopwords\n"
     ]
    }
   ],
   "source": [
    "with open('../data/clinical-stopwords.txt', 'r') as f:\n",
    "    clinical_stopwords = set(line.strip().lower() for line in f if line.strip())\n",
    "\n",
    "print(f\"Loaded {len(clinical_stopwords)} clinical stopwords\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9670dbfc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def tokenize_and_clean(text, stopword_set):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    tokens = re.findall(r'\\b[a-z]+\\b', text)\n",
    "    tokens = [t for t in tokens if t not in stopword_set and len(t) > 1]\n",
    "    return tokens"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "665443ad",
   "metadata": {},
   "source": [
    "#Loading the GloVe from the stanford glove vectors "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "bee0c154",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Loaded 400000 real GloVe vectors.\n"
     ]
    }
   ],
   "source": [
    "embeddings_index = {}\n",
    "with open('../data/glove/glove.6B.100d.txt', 'r', encoding='utf-8') as f:\n",
    "    for line in f:\n",
    "        values = line.split()\n",
    "        word = values[0]\n",
    "        vector = np.asarray(values[1:], dtype='float32')\n",
    "        embeddings_index[word] = vector\n",
    "\n",
    "print(f\"Loaded {len(embeddings_index)} real GloVe vectors.\")"
   ]
  },
